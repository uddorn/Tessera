# Generate a secure local .env with: pnpm infra:env
NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:5173

# PostgreSQL 18
POSTGRES_DB=tessera
POSTGRES_USER=tessera
POSTGRES_PASSWORD=replace-with-a-random-password
DATABASE_URL=postgresql://tessera:replace-with-a-random-password@localhost:5432/tessera

# Valkey 9
VALKEY_PASSWORD=replace-with-a-random-password
VALKEY_URL=redis://:replace-with-a-random-password@localhost:6379

# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-random-password
KEYCLOAK_ISSUER=http://localhost:8080/realms/tessera

# Garage S3 (use pnpm infra:env to generate valid values)
GARAGE_RPC_SECRET=replace-with-64-hex-characters
GARAGE_ADMIN_TOKEN=replace-with-a-random-token
GARAGE_METRICS_TOKEN=replace-with-a-random-token
GARAGE_ACCESS_KEY=GKreplace-with-32-hex-characters
GARAGE_SECRET_KEY=replace-with-64-hex-characters
GARAGE_BUCKET=tessera-attachments
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage

# Mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
